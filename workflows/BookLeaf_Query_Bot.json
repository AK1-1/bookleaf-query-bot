      "id": "5daca474-4e7b-4051-af5f-17429c765f71",
      "name": "Get many rows1",
      "credentials": {
        "supabaseApi": {
          "id": "cny8vgadQfLa5kx1",
          "name": "Supabase account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst classificationData = $('Parse Classification1').first().json;\n\nconst validResults = items.filter(item => {\n  return item.json && \n         item.json.email && \n         item.json.email !== null && \n         item.json.email !== '' &&\n         Object.keys(item.json).length > 1;\n});\n\nconst resultCount = validResults.length;\n\nif (resultCount === 0) {\n  return [{\n    json: {\n      ...classificationData,\n      match_status: 'no_match',\n      author_data: null,\n      result_count: 0\n    }\n  }];\n} else if (resultCount === 1) {\n  return [{\n    json: {\n      ...classificationData,\n      match_status: 'single_match',\n      author_data: validResults[0].json,\n      result_count: 1\n    }\n  }];\n} else {\n  return [{\n    json: {\n      ...classificationData,\n      match_status: 'multiple_matches',\n      author_data: validResults[0].json,\n      result_count: resultCount\n    }\n  }];\n}"
      },
