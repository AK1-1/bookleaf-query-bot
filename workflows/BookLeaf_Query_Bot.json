    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst classData = $('Parse Classification1').first().json;\n\nlet context = '';\n\nif (items.length > 0) {\n  const texts = items\n    .map(item => {\n      if (item.json.document?.pageContent) return item.json.document.pageContent;\n      if (item.json.pageContent) return item.json.pageContent;\n      if (item.json.content) return item.json.content;\n      return null;\n    })\n    .filter(t => t !== null && typeof t === 'string' && !t.match(/^[\\d.,\\-\\s]+$/));\n\n  context = texts.length > 0 \n    ? texts.join('\\n\\n') \n    : 'No relevant information found in knowledge base.';\n} else {\n  context = 'No relevant information found in knowledge base.';\n}\n\nreturn [{\n  json: {\n    ...classData,\n    context: context\n  }\n}];"
      },
