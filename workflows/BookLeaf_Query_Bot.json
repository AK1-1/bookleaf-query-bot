          "mode": "list",
          "cachedResultName": "GPT-5.4-MINI"
        },
        "messages": {
          "values": [
            {
              "content": "=You are a query classifier for BookLeaf Publishing, a self-publishing platform in India.\n\nClassify the author's query into ONE of these intents:\n- book_status (is my book live, when will it publish, submission status, timeline)\n- royalty_inquiry (royalty payment, royalty report, earnings, payout)\n- dashboard_access (login issues, dashboard access, can't access account, password)\n- addon_status (bestseller package, PR campaign, award submission, marketing add-ons)\n- book_sales (sales numbers, how many copies sold, sales report)\n- author_copy (author copy delivery, shipping status, physical copies)\n- general_inquiry (anything that doesn't fit above — general questions about policies, requirements, process, pricing, formats, etc.)\n- greeting (hello, hi, I have a query, general conversation starters, thank you, bye)\n\nIMPORTANT: If the question is about general publishing policies, requirements, processes, pricing, or how things work at BookLeaf — classify as general_inquiry. Only classify as account-specific intents (book_status, royalty_inquiry, etc.) if the author is asking about THEIR specific book or account.\n\nAlso extract any identifiers from the query: email addresses, book titles, or author names.\n\nRespond ONLY in this exact JSON format, nothing else:\n{\n  \"intent\": \"book_status\",\n  \"confidence\": 92,\n  \"extracted_email\": null,\n  \"extracted_book_title\": null,\n  \"extracted_author_name\": null\n}\n\nConfidence should be 0-100. If the query is vague or ambiguous, lower the confidence.",
              "role": "system"
            },
            {
              "content": "=Author email: {{ $('Set Input Fields1').first().json.email }}\nAuthor query: {{ $('Set Input Fields1').first().json.query }}"
            }
          ]
        },
        "options": {
          "maxTokens": 200
        }
      },
      "id": "f359b1b2-6219-4e82-808f-c61e234d9c2a",
      "name": "OpenAI - Classify Intent1",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.4,
      "position": [
        -3616,
        2320
      ],
      "credentials": {
        "openAiApi": {
          "id": "r6DgVlzLKWp2CCM2",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $input.all()[0];\nconst prevData = $('Set Input Fields1').first().json;\n\nlet classification;\ntry {\n  let responseText = input.json.message?.content || input.json.text || JSON.stringify(input.json);\n  responseText = responseText.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  classification = JSON.parse(responseText);\n} catch (e) {\n  classification = {\n    intent: 'general_inquiry',\n    confidence: 50,\n    extracted_email: null,\n    extracted_book_title: null,\n    extracted_author_name: null\n  };\n}\n\nconst authorEmail = classification.extracted_email || prevData.email;\n\n// Determine routing\nconst dbRequiredIntents = ['book_status', 'royalty_inquiry', 'dashboard_access', 'addon_status', 'book_sales', 'author_copy'];\nconst greetingIntents = ['greeting'];\nconst needsDb = dbRequiredIntents.includes(classification.intent) && authorEmail;\nconst needsEmail = dbRequiredIntents.includes(classification.intent) && !authorEmail;\n\nlet route = 'rag_search';\nif (greetingIntents.includes(classification.intent)) route = 'greeting';\nelse if (needsEmail) route = 'ask_email';\nelse if (needsDb && classification.confidence >= 80) route = 'db_lookup';\nelse if (needsDb && classification.confidence < 80) route = 'escalate';\n\nreturn [{\n  json: {\n    query: prevData.query,\n    email: authorEmail || '',\n    channel: prevData.channel,\n    intent: classification.intent,\n    confidence: classification.confidence,\n    extracted_book_title: classification.extracted_book_title,\n    extracted_author_name: classification.extracted_author_name,\n    route: route\n  }\n}];"
      },
      "id": "57085d5b-e161-4af6-9b26-50fd14301a92",
      "name": "Parse Classification1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
